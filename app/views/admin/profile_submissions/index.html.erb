<div class="editor-page"><h1>Предложения пользователей</h1><% if notice %><p role="status"><%= notice %></p><% end %><% if alert %><p role="alert"><%= alert %></p><% end %>
<% @submissions.each do |item| %><section class="admin-section-card"><h2><%= item.title %></h2><p><%= item.user.name %> · @<%= item.user.username %> · <%= ProfileSubmission::KINDS.fetch(item.kind) %></p><p><%= simple_format(item.description) %></p><% if item.image.present? %><%= image_tag item.image.url, alt: item.title, style: "max-width:320px;width:100%" %><% end %>
<%= form_with model: item, url: admin_profile_submission_path(item) do |f| %><%= f.label :status, "Статус" %><%= f.select :status, ProfileSubmission::STATUSES.map { |key, title| [title, key] } %><%= f.submit "Сохранить" %><% end %></section><% end %><% if @submissions.empty? %><p>Предложений пока нет.</p><% end %></div>
