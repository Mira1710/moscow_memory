<% content_for :title, "Мой профиль — Москведение" %>
<section class="profile-summary">
  <% if Rails.root.join("app/assets/images/profile/avatar.jpg").file? %><%= image_tag "profile/avatar.jpg", alt: "", class: "profile-avatar" %><% else %><div class="profile-avatar profile-avatar-placeholder" aria-hidden="true"><%= current_user.name.first.upcase %></div><% end %>
  <div><div class="profile-heading"><h1><%= current_user.name %></h1><span>Москвед с <%= current_user.created_at.strftime("%m.%Y") %></span></div>
    <p><b>Ник:</b> @<%= current_user.username %></p><p><b>Статус:</b> Исследователь</p><p><b>Маршруты:</b> <%= @submissions.count { |item| item.kind == "route" && item.status == "accepted" } %></p>
  </div>
  <%= button_to "Выйти", user_logout_path, method: :delete, class: "profile-logout" %>
</section>
<section class="profile-public profile-panel"><h2>Публичное</h2>
  <div class="profile-columns">
    <section><h3>Маршруты</h3><%= link_to "Предложить маршрут", new_profile_submission_path(kind: "route"), class: "profile-primary" %>
    <% ProfileSubmission::STATUSES.sort_by { |key, _| ["accepted", "pending", "revision"].index(key) }.each do |status, title| %><h4 class="profile-label"><%= title %></h4><div class="profile-card-row">
      <% items = @submissions.select { |item| item.kind == "route" && item.status == status } %>
      <%= render partial: "submission", collection: items %><% if items.empty? %><p class="profile-empty">Пока нет маршрутов.</p><% end %>
    </div><% end %></section>
    <section><h3>Архив</h3><%= link_to "Пополнить архив", new_profile_submission_path(kind: "photo"), class: "profile-primary" %>
      <% { "photo" => "Фото", "map" => "Карты", "sound" => "Звуки" }.each do |kind, title| %><h4 class="profile-label"><%= title %></h4><div class="profile-card-row">
        <% items = @submissions.select { |item| item.kind == kind } %><%= render partial: "submission", collection: items %>
        <% if items.empty? %><p class="profile-empty">Материалы пока не добавлены.</p><% end %>
      </div><% end %>
    </section>
  </div>
</section>
<div class="routes-space" aria-hidden="true"></div>
