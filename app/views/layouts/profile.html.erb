<% content_for :content do %>
<div <%= 'data-account-role="user" style="visibility:hidden"'.html_safe if current_user %> class="moscow-memory section-page routes-page profile-page" data-controller="routes-menu" data-action="keydown.esc@window->routes-menu#close">
  <%= render "shared/sidebar", active_section: "profile" %>
  <main>
    <header class="routes-mobile-header">
      <%= link_to root_path, class: "routes-mobile-logo", aria: { label: "Москведение — главная" } do %><%= image_tag "mobile-logo.svg", alt: "Москведение" %><% end %>
      <span>Профиль</span>
      <button type="button" aria-label="Открыть меню" aria-controls="profile-navigation" aria-expanded="false" data-routes-menu-target="button" data-action="routes-menu#toggle"><i aria-hidden="true">☰</i></button>
    </header>
    <% if notice %><p class="profile-flash" role="status"><%= notice %></p><% end %>
    <% if alert %><p class="profile-flash profile-error" role="alert"><%= alert %></p><% end %>
    <%= yield %>
<footer class="site-footer routes-footer">
  <div>Цифровой архив Москвы.<br>© Москведение, <%= Date.current.year %></div>
  <div><%= link_to "Источники", places_path %></div>
  <div class="footer-links"><button type="button" disabled title="Добавьте ссылку на вашу политику">Политика конфиденциальности</button><button type="button" disabled title="Добавьте контакт проекта">Обратная связь</button></div>
  <div class="footer-links"><button type="button" disabled title="Добавьте адрес канала">Telegram ↗</button><button type="button" disabled title="Добавьте адрес сообщества">VK ↗</button></div>
</footer>
  </main>
</div>
<% end %>
<%= render template: "layouts/application" %>
