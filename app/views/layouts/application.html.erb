<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Moscow Memory" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Moscow Memory">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <% if controller_path.start_with?("admin/") || %w[user_accounts profile_submissions].include?(controller_name) %><meta name="turbo-cache-control" content="no-cache"><% end %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if (role = session.delete(:tab_login_role)).present? %><meta name="tab-login-role" content="<%= role %>"><% end %>
    <%= content_for?(:content) ? yield(:content) : yield %>
  </body>
</html>
