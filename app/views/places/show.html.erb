<main>
  <%= link_to "← Назад к архиву", places_path %>
  <%= link_to "Редактировать объект", edit_place_path(@place) %>
  <%= button_to "Удалить объект",
                @place,
                method: :delete,
                data: { turbo_confirm: "Точно удалить этот объект?" } %>

  <article>
    <% if @place.image.present? %>
      <%= image_tag @place.image.url, alt: @place.name, width: 600 %>
    <% else %>
      <%= image_tag "/placeholder.jpeg", alt: @place.name, width: 600 %>
    <% end %>

    <h1><%= @place.name %></h1>

    <p>
      <strong>Адрес:</strong>
      <%= @place.address %>
    </p>

    <p>
      <strong>Период:</strong>
      <%= @place.year_from %>–<%= @place.year_to %>
    </p>

    <p>
      <%= @place.description %>
    </p>

    <h2>Расположение</h2>

    <p>
      Широта: <%= @place.latitude %><br>
      Долгота: <%= @place.longitude %>
    </p>

    <div>
      Здесь позже будет фрагмент карты с выбранным объектом
    </div>
    <section>
      <h2>История места</h2>

      <% if @place.historical_states.any? %>
        <% @place.historical_states.order(:year_from).each do |state| %>
          <div>
            <h3><%= state.title %></h3>

            <p>
              <strong>Период:</strong>
              <%= state.year_from %>–<%= state.year_to %>
            </p>

            <p>
              <%= state.description %>
            </p>
          </div>

          <hr>
        <% end %>
      <% else %>
        <p>История этого места пока не добавлена.</p>
      <% end %>
    </section>
  </article>
</main>