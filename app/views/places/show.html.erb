<% content_for :title, "#{@place.name} — Москведение" %>
<div class="editor-page"><nav><%= link_to "← Архив", (controller_path.start_with?("admin/") ? admin_places_path : places_path) %> <% unless admin_interface? %>· <%= link_to "Карта", root_path %><% end %> · <% if admin_interface? %><%= link_to "Редактировать статью", edit_admin_place_path(@place) %><% end %></nav>
<% if notice.present? %><p role="status"><%= notice %></p><% end %>
<article class="moscow-memory standalone-article"><div class="article-body"><%= render "home/map_article", place: @place %></div></article>
<% if admin_interface? %><%= button_to "Удалить объект и его статью", [:admin, @place], method: :delete, data: { turbo_confirm: "Удалить объект, его периоды и изображения?" }, class: "editor-remove" %><% end %>
</div>
