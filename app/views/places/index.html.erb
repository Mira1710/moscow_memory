<% content_for :title, "Архив — Москведение" %>
<div class="editor-page"><% unless admin_interface? %><nav><%= link_to "← Карта", root_path %> · <%= link_to "Статьи", articles_path %></nav><% end %>
<h1><%= controller_path.start_with?("admin/") ? "Админка — статьи" : "Архив мест и статей" %></h1>
<% if admin_interface? %>
  <div class="admin-toolbar"><%= link_to "+ Добавить место и статью", new_admin_place_path, class: "editor-add-link" %></div>
<% end %>
<% if notice.present? %><p role="status"><%= notice %></p><% end %>
<div class="editor-place-list"><% @places.each do |place| %><article><h2><%= link_to place.name, (controller_path.start_with?("admin/") ? admin_place_path(place) : place_path(place)) %></h2><p><%= place.address %></p><p><%= place.historical_states.size %> исторических периодов</p><% if admin_interface? %><%= link_to "Редактировать статью", edit_admin_place_path(place) %><% end %></article><% end %></div>
</div>
